        "receiptType": { "type": "string", "enum": ["Receipt", "Donation", "Deposit"] },
        "institutionName": { "type": "string", "maxLength": 120 },
        "branchId": { "type": "string", "maxLength": 128 },
        "donorName": { "type": "string", "maxLength": 120 },
        "donorPhone": { "type": "string", "maxLength": 40 },
        "niyyat": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 100 },
        "paymentMode": { "type": "string", "enum": ["Cash", "Bank Transfer", "Cheque", "Online"] },
        "amount": { "type": "number" },
        "receiptDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "monthKey": { "type": "string", "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" },
        "status": { "type": "string", "enum": ["active", "refunded", "cancelled"] },
        "refundReason": { "type": "string", "maxLength": 300 },
        "issuedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["receiptNo", "receiptType", "institutionName", "branchId", "donorName", "niyyat", "paymentMode", "amount", "receiptDate", "monthKey", "status", "issuedBy", "createdAt", "updatedAt"]
    },
    "FinanceEntry": {
      "title": "FinanceEntry",
      "description": "ERP & Finance ledger covering accounts, income, expenses, budgets, fees, and assets.",
      "type": "object",
      "properties": {
        "entryType": { "type": "string", "enum": ["account", "income", "expense", "budget", "fee", "asset"] },
        "institutionName": { "type": "string", "maxLength": 120 },
        "branchId": { "type": "string", "maxLength": 128 },
        "departmentId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 160 },
        "accountCode": { "type": "string", "maxLength": 40 },
        "category": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "fiscalMonth": { "type": "string", "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" },
        "entryDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "status": { "type": "string", "enum": ["posted", "pending", "cancelled"] },
        "notes": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["entryType", "institutionName", "branchId", "title", "category", "amount", "fiscalMonth", "entryDate", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Institutional notice board and communication entry.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 2000 },
        "audience": { "type": "string", "enum": ["All Staff", "Teachers", "HR & Principals", "Department Specific"] },
        "branchId": { "type": "string", "maxLength": 128 },
        "departmentId": { "type": "string", "maxLength": 128 },
        "priority": { "type": "string", "enum": ["Normal", "Important", "Urgent"] },
        "publishedBy": { "type": "string", "maxLength": 128 },
        "publishedByName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["published", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "audience", "priority", "publishedBy", "status", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only system log and approval audit trail.",
      "type": "object",
      "properties": {
        "action": { "type": "string", "maxLength": 120 },
        "module": { "type": "string", "maxLength": 80 },
        "entityType": { "type": "string", "maxLength": 80 },
        "entityId": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 254 },
        "actorRole": { "type": "string", "maxLength": 60 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "module", "entityType", "entityId", "actorUid", "actorEmail", "actorRole", "details", "createdAt"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Master institutional settings, E-Raseed config, and backup logs.",
      "type": "object",
      "properties": {
        "configType": { "type": "string", "enum": ["master", "eraseed", "backup"] },
        "institutionName": { "type": "string", "maxLength": 120 },
        "receiptPrefix": { "type": "string", "maxLength": 20 },
        "defaultCurrency": { "type": "string", "maxLength": 12 },
        "academicYear": { "type": "string", "maxLength": 40 },
        "lastBackupAt": { "type": "string", "maxLength": 40 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["configType", "updatedBy", "updatedAt"]
    }
  },
